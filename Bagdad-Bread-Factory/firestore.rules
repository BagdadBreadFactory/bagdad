rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isOwner(uid){ return signedIn() && request.auth.uid == uid; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role(){ return signedIn() ? userDoc().data.role : null; }
    function isAdmin(){ return signedIn() && role() == 'admin'; }
    function isManager(){ return signedIn() && (role() == 'admin' || role() == 'manager'); }
    function isBranchManager(){ return signedIn() && role() == 'branch_manager'; }
    function isFactory(){ return signedIn() && (role() == 'factory_staff' || role() == 'staff' || role() == 'manager' || role() == 'admin'); }
    function isAttendance(){ return signedIn() && (role() == 'attendance_staff' || role() == 'staff' || role() == 'manager' || role() == 'branch_manager' || role() == 'admin'); }
    function isDelivery(){ return signedIn() && (role() == 'delivery' || role() == 'factory_staff' || role() == 'staff' || role() == 'manager' || role() == 'branch_manager' || role() == 'admin'); }
    function isStaff(){ return signedIn() && role() in ['delivery','staff','factory_staff','attendance_staff','manager','branch_manager','admin']; }
    function sameBranchData(){ return isBranchManager() && resource.data.branchId == userDoc().data.branchId; }
    function sameBranchNew(){ return isBranchManager() && request.resource.data.branchId == userDoc().data.branchId; }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.branchId == resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update: if isManager() || isBranchManager();
      allow delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update: if isManager() || isBranchManager();
      allow delete: if isAdmin();
    }
    match /offers/{id} {
      allow read: if true;
      allow create, update: if isManager() || isBranchManager();
      allow delete: if isAdmin();
    }
    match /branches/{id} {
      allow read: if true;
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow get: if true;
      allow list: if isManager() || isStaff() || (isBranchManager() && resource.data.branchId == userDoc().data.branchId) || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update: if isManager() || isStaff() || (isBranchManager() && resource.data.branchId == userDoc().data.branchId && request.resource.data.branchId == userDoc().data.branchId);
      allow delete: if isAdmin();
    }
    match /cakeRequests/{id} {
      allow get: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isStaff();
      allow create: if true;
      allow update: if isManager() || isStaff();
      allow delete: if isAdmin();
    }
    match /customers/{id} {
      allow read: if isManager() || isBranchManager() || isStaff() || isOwner(id);
      allow create: if isStaff() || isBranchManager();
      allow update: if isManager() || isBranchManager() || isStaff() || isOwner(id);
      allow delete: if isAdmin();
    }

    match /inventory/{id} {
      allow read: if isManager() || isStaff() || isBranchManager();
      allow create: if isManager() || role() == 'factory_staff' || (isBranchManager() && sameBranchNew());
      allow update: if isManager() || role() == 'factory_staff' || (isBranchManager() && sameBranchData() && request.resource.data.branchId == userDoc().data.branchId);
      allow delete: if isAdmin();
    }
    match /stockMovements/{id} {
      allow read: if isManager() || isStaff() || isBranchManager();
      allow create: if isManager() || role() == 'factory_staff' || isBranchManager();
      allow update, delete: if isAdmin();
    }
    match /stockTransfers/{id} {
      allow read: if isManager() || isFactory() || isBranchManager();
      allow create: if isManager() || role() == 'factory_staff';
      allow update: if isManager() || (isBranchManager() && sameBranchData());
      allow delete: if isAdmin();
    }

    match /suppliers/{id} {
      allow read: if isManager() || isBranchManager();
      allow create, update: if isManager() || isBranchManager();
      allow delete: if isAdmin();
    }
    match /purchases/{id} {
      allow read: if isManager() || isBranchManager() || role() == 'factory_staff';
      allow create: if isManager() || role() == 'factory_staff' || isBranchManager();
      allow update: if isManager() || isBranchManager();
      allow delete: if isAdmin();
    }
    match /productCosts/{id} {
      allow read: if isManager() || isBranchManager() || isFactory();
      allow create, update: if isManager() || isBranchManager() || role() == 'factory_staff';
      allow delete: if isAdmin();
    }

    match /shipments/{id} {
      allow read: if isManager() || isDelivery() || (isBranchManager() && sameBranchData());
      allow create: if isManager() || role() == 'factory_staff' || isBranchManager();
      allow update: if isManager() || isDelivery() || (isBranchManager() && sameBranchData());
      allow delete: if isAdmin();
    }
    match /expenses/{id} {
      allow read: if isManager() || (isBranchManager() && sameBranchData());
      allow create, update: if isManager() || (isBranchManager() && sameBranchNew());
      allow delete: if isAdmin();
    }
    match /employees/{id} {
      allow read: if isManager() || (isBranchManager() && sameBranchData()) || role() == 'attendance_staff';
      allow create, update: if isManager() || (isBranchManager() && sameBranchNew());
      allow delete: if isAdmin();
    }
    match /attendance/{id} {
      allow read: if isManager() || isAttendance() || (isBranchManager() && sameBranchData());
      allow create: if isAttendance();
      allow update: if isManager() || (isBranchManager() && sameBranchData());
      allow delete: if isAdmin();
    }
    match /reports/{id} {
      allow read, create, update: if isManager() || isBranchManager();
      allow delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /activityLogs/{id} {
      allow read: if isAdmin() || isManager() || (isBranchManager() && resource.data.branchId == userDoc().data.branchId);
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isManager();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
